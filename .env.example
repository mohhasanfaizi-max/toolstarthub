# ToolsTartHub does not require environment variables for local development
# or a standard Vercel deploy. There are no API keys or database credentials.
#
# Do not put secrets in NEXT_PUBLIC_* variables. Anything with that prefix
# is exposed to the browser.

# Canonical public URL used for sitemap, robots, Open Graph, and JSON-LD.
# Defaults to https://www.toolstarhub.com when unset.
# The root domain toolstarhub.com should redirect to this www host.
# Do not set this to a Vercel preview URL unless you intentionally want
# preview pages to be treated as canonical.
# NEXT_PUBLIC_SITE_URL=https://www.toolstarhub.com

# Optional Google Search Console HTML-tag verification token.
# In Search Console, choose URL-prefix property https://www.toolstarhub.com
# then "HTML tag". Paste only the content="..." token value here, not the
# full meta tag. Alternatively place the HTML file Search Console gives you
# in /public (for example public/googleXXXXXXXX.html).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional public contact mailbox shown on /contact as a mailto link.
# Leave unset until a real mailbox exists. Do not use a fake address.
# NEXT_PUBLIC_CONTACT_EMAIL=
