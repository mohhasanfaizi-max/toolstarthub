# ToolsTartHub builds without environment variables.
# The five AI buttons need a server-side Gemini key. Leave it unset to keep
# those buttons in the "not available" state. Do not commit a real key.
#
# Do not put secrets in NEXT_PUBLIC_* variables. Anything with that prefix
# is exposed to the browser.

# Canonical public URL used for sitemap, robots, Open Graph, and JSON-LD.
# Defaults to https://www.toolstarhub.com when unset.
# Do not set this to a Vercel preview URL unless you intentionally want
# preview pages to be treated as canonical.
# NEXT_PUBLIC_SITE_URL=https://www.toolstarhub.com

# Optional Google Search Console HTML-tag verification token.
# In Search Console, choose URL-prefix property https://www.toolstarhub.com
# then "HTML tag". Paste only the content="..." token value here, not the
# full meta tag. Alternatively place the HTML file Search Console gives you
# in /public (for example public/googleXXXXXXXX.html).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional override for the mailbox on /contact.
# When unset, the page uses the mailbox in src/lib/site.ts.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only Gemini API key. Copy this name into .env.local for local AI tests:
# GEMINI_API_KEY=your_key_here
# Never use NEXT_PUBLIC_GEMINI_API_KEY. The browser must not receive the key.
GEMINI_API_KEY=

# Optional model override. When unset, the server uses gemini-3.5-flash-lite.
# GEMINI_MODEL=

# In-memory AI rate limit. Counts requests only. Prompt text is not stored.
# Each server instance has its own counter. Defaults: 10 requests per 60 seconds.
# AI_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_WINDOW_MS=60000
